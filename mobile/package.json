{
  "name": "mobile",
  "version": "0.3.2.2",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:reverse": "adb reverse tcp:8081 tcp:8081",
    "android:start:device:debug": "bash ./scripts/android-start-debug-device.sh",
    "android:build:device:debug": "bash ./scripts/android-build-debug-device.sh",
    "android:install:device:debug": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:build:release:local": "bash ./scripts/android-build-release-local.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "prepare": "npm_pkg_dir=$PWD && cd .. && node $npm_pkg_dir/node_modules/husky/bin.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.15.2",
    "@react-navigation/material-top-tabs": "^7.6.2",
    "@react-navigation/native": "^7.1.31",
    "@react-navigation/native-stack": "^7.14.2",
    "@sentry/react-native": "^8.14.0",
    "@supabase/supabase-js": "^2.98.0",
    "@types/react": "~19.1.10",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.12",
    "expo-camera": "~17.0.10",
    "expo-font": "~14.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-pager-view": "6.9.1",
    "react-native-paper": "^5.15.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-preset-expo": "~54.0.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.6",
    "lint-staged": "^17.0.8",
    "prettier": "^3.4.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "brace-expansion": "1.1.12",
    "js-yaml": "^5.2.2",
    "shell-quote": "^1.10.0",
    "uuid": ">=11.1.1",
    "ws": "^8.21.0",
    "tar@<=7.5.21": "7.5.21"
