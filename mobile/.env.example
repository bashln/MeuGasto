# MeuGasto - template de configuração local
#
# Copie para mobile/.env e preencha apenas para builds que usem o modo Nuvem.
# O arquivo .env não é versionado. Nunca comite valores reais.
#
# O build lê estas chaves do ambiente ou de mobile/.env e injeta em BuildConfig.
# Sem valores configurados o app inicia em modo Local-First, sem nuvem.

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Assinatura do APK de release (opcional, apenas build local assinado)
# MEUGASTO_STORE_FILE=/caminho/para/meugasto-release.jks
# MEUGASTO_STORE_PASSWORD=
# MEUGASTO_KEY_ALIAS=
# MEUGASTO_KEY_PASSWORD=
