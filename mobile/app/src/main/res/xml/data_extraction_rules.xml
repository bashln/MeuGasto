<?xml version="1.0" encoding="utf-8"?>
<!--
    Nada do app sai por backup em nuvem ou transferencia entre aparelhos:
    banco Room, preferencias (incluindo e-mail e nome) e arquivos privados
    ficam fora. A exportacao LGPD e o unico caminho de saida, e e explicita.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
